{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // Node runs the build output directly, so emit Node-resolvable ESM
    // (explicit .js specifiers). `web` keeps Bundler resolution for Vite.
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["src"]
}

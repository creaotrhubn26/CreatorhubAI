{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "glimmer-compute-coordinator",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  // Pod callbacks to *.workers.dev never reached the worker (edge-filtered
  // from RunPod data-center IPs), so callbacks go through a dedicated infra
  // domain instead.
  "routes": [
    {
      "pattern": "coordinator.creatorhubn-infra.com",
      "custom_domain": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "ComputeCoordinator",
      },
    ],
  },
  "services": [
    {
      "binding": "WATCHDOG",
      "service": "glimmer-runpod-watchdog",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ComputeCoordinator"],
    },
  ],
  "vars": {
    "RUNPOD_API_BASE_URL": "https://rest.runpod.io",
    "RUNPOD_CATALOG_API_BASE_URL": "https://api.runpod.io",
    // 2026-09-02: cpu3c (2 vCPU Secure, EUR-IS-1) trades around $0.06/h, so the
    // previous $0.0225 ceiling made every cpu_cache job fail with CPU_UNAVAILABLE.
    // Worst case at this ceiling: 0.075 * (1680+120)/3600 = $0.0375 per attempt.
    "CPU_CACHE_MAX_HOURLY_USD": "0.075",
    "CPU_CACHE_TTL_SECONDS": "1680",
    "CACHE_REPAIR_GPU_FALLBACK_ID": "NVIDIA L4",
    "CACHE_REPAIR_GPU_MAX_HOURLY_USD": "0.49",
    "CACHE_REPAIR_MAX_TOTAL_USD": "0.25",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}

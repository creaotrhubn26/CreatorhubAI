{
  "suiteVersion": "1.0.0",
  "tasks": [
    {
      "id": "create-hello-module",
      "category": "create",
      "objective": "Create hello.py with a greet(name) function that returns a friendly greeting string.",
      "scopePackage": "files",
      "scopePaths": [
        "hello.py"
      ],
      "maxRepairs": 1,
      "maxChangedFiles": 3,
      "fixtureFiles": {
        "README.md": "# fixture repo\n"
      },
      "verify": [
        "python3 -B -c \"import sys, hello; sys.exit(0 if 'Ada' in hello.greet('Ada') else 1)\""
      ],
      "stub": {
        "invocations": [
          [
            {
              "tool": "write_file",
              "arguments": {
                "path": "hello.py",
                "content": "def greet(name):\n    return f\"Hello, {name}!\"\n"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff --check"
              }
            },
            {
              "finish": "Created hello.py with a greet function."
            }
          ]
        ]
      },
      "expected": {
        "filesExist": [
          "hello.py"
        ],
        "fileContains": {
          "hello.py": [
            "def greet"
          ]
        }
      },
      "expectedOutcome": {
        "taskSuccess": true,
        "falseVerified": false,
        "budgetAdherence": true
      }
    },
    {
      "id": "create-config-file",
      "category": "create",
      "objective": "Create a config.json file with a debug flag and a version number.",
      "scopePackage": "files",
      "scopePaths": [
        "config.json"
      ],
      "maxRepairs": 1,
      "maxChangedFiles": 3,
      "fixtureFiles": {
        "src/app.py": "print('app')\n"
      },
      "verify": [
        "python3 -B -c \"import json, sys; d = json.load(open('config.json')); sys.exit(0 if d.get('version') == 1 else 1)\""
      ],
      "stub": {
        "invocations": [
          [
            {
              "tool": "write_file",
              "arguments": {
                "path": "config.json",
                "content": "{\n  \"debug\": false,\n  \"version\": 1\n}\n"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff --check"
              }
            },
            {
              "finish": "Created config.json with debug and version fields."
            }
          ]
        ]
      },
      "expected": {
        "filesExist": [
          "config.json"
        ],
        "fileContains": {
          "config.json": [
            "\"version\": 1"
          ]
        }
      },
      "expectedOutcome": {
        "taskSuccess": true,
        "falseVerified": false,
        "budgetAdherence": true
      }
    },
    {
      "id": "modify-bump-version",
      "category": "modify",
      "objective": "Bump the VERSION constant in version.py from 1.0.0 to 1.1.0.",
      "scopePackage": "files",
      "scopePaths": [
        "version.py"
      ],
      "maxRepairs": 1,
      "maxChangedFiles": 3,
      "fixtureFiles": {
        "version.py": "VERSION = \"1.0.0\"\n"
      },
      "verify": [
        "grep -q 'VERSION = \"1.1.0\"' version.py"
      ],
      "stub": {
        "invocations": [
          [
            {
              "tool": "edit_file",
              "arguments": {
                "path": "version.py",
                "old_string": "VERSION = \"1.0.0\"",
                "new_string": "VERSION = \"1.1.0\""
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff --check"
              }
            },
            {
              "finish": "Bumped VERSION to 1.1.0."
            }
          ]
        ]
      },
      "expected": {
        "fileContains": {
          "version.py": [
            "VERSION = \"1.1.0\""
          ]
        },
        "fileNotContains": {
          "version.py": [
            "1.0.0"
          ]
        }
      },
      "expectedOutcome": {
        "taskSuccess": true,
        "falseVerified": false,
        "budgetAdherence": true
      }
    },
    {
      "id": "modify-add-function-rigged-false-verified",
      "category": "modify",
      "comment": "Rigged fixture (V7 O5/39): --verify given to v2 is a trivially-true check, so v2 legitimately reports 'verified'; the harness's OWN (stricter) `expected` grading of the same deliverable fails. Proves the falseVerified detector fires on a real (not synthetic) session.",
      "objective": "Add a square(x) function to utils.py.",
      "scopePackage": "files",
      "scopePaths": [
        "utils.py"
      ],
      "maxRepairs": 1,
      "maxChangedFiles": 3,
      "fixtureFiles": {
        "utils.py": "def double(x):\n    return x * 2\n"
      },
      "verify": [
        "true"
      ],
      "stub": {
        "invocations": [
          [
            {
              "tool": "edit_file",
              "arguments": {
                "path": "utils.py",
                "old_string": "def double(x):\n    return x * 2\n",
                "new_string": "def double(x):\n    return x * 2\n\ndef triple(x):\n    return x * 3\n"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff --check"
              }
            },
            {
              "finish": "Added a helper function to utils.py."
            }
          ]
        ]
      },
      "expected": {
        "fileContains": {
          "utils.py": [
            "def square(x)"
          ]
        }
      },
      "expectedOutcome": {
        "taskSuccess": false,
        "falseVerified": true,
        "budgetAdherence": true
      }
    },
    {
      "id": "repair-fix-arithmetic-bug",
      "category": "repair",
      "objective": "Fix the bug in repair.py so add(2, 3) returns 5.",
      "scopePackage": "files",
      "scopePaths": [
        "repair.py"
      ],
      "maxRepairs": 2,
      "maxChangedFiles": 3,
      "fixtureFiles": {
        "repair.py": "def add(a, b):\n    return a - b\n"
      },
      "verify": [
        "python3 -B -c \"import repair, sys; sys.exit(0 if repair.add(2, 3) == 5 else 1)\""
      ],
      "stub": {
        "invocations": [
          [
            {
              "tool": "edit_file",
              "arguments": {
                "path": "repair.py",
                "old_string": "return a - b",
                "new_string": "return a * b"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff --check"
              }
            },
            {
              "finish": "Fixed add() to use multiplication."
            }
          ],
          [
            {
              "tool": "edit_file",
              "arguments": {
                "path": "repair.py",
                "old_string": "return a * b",
                "new_string": "return a + b"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff --check"
              }
            },
            {
              "finish": "Fixed add() to use addition, verified this time."
            }
          ]
        ]
      },
      "expected": {
        "fileContains": {
          "repair.py": [
            "return a + b"
          ]
        }
      },
      "expectedOutcome": {
        "taskSuccess": true,
        "falseVerified": false,
        "budgetAdherence": true
      }
    },
    {
      "id": "repair-fix-off-by-one",
      "category": "repair",
      "objective": "Fix count_positive in counter.py so it counts positive numbers correctly (off-by-one bug).",
      "scopePackage": "files",
      "scopePaths": [
        "counter.py"
      ],
      "maxRepairs": 2,
      "maxChangedFiles": 3,
      "fixtureFiles": {
        "counter.py": "def count_positive(xs):\n    n = 0\n    for x in xs:\n        if x > 1:\n            n += 1\n    return n\n"
      },
      "verify": [
        "python3 -B -c \"import counter, sys; sys.exit(0 if counter.count_positive([1, 2, 3]) == 3 else 1)\""
      ],
      "stub": {
        "invocations": [
          [
            {
              "tool": "edit_file",
              "arguments": {
                "path": "counter.py",
                "old_string": "if x > 1:",
                "new_string": "if x > 2:"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff --check"
              }
            },
            {
              "finish": "Loosened the threshold."
            }
          ],
          [
            {
              "tool": "edit_file",
              "arguments": {
                "path": "counter.py",
                "old_string": "if x > 2:",
                "new_string": "if x > 0:"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff --check"
              }
            },
            {
              "finish": "Fixed the off-by-one: positive means > 0."
            }
          ]
        ]
      },
      "expected": {
        "fileContains": {
          "counter.py": [
            "if x > 0:"
          ]
        }
      },
      "expectedOutcome": {
        "taskSuccess": true,
        "falseVerified": false,
        "budgetAdherence": true
      }
    },
    {

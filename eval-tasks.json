{
  "suiteVersion": "1.0.0",
  "_coverage": "V7 §39 names 11 benchmark categories; this suite covers 6: create (repository/small-feature creation), modify (small bug fix), repair (test/verification repair), refuse (impossible task + security-sensitive refusal), typefix (type error), multifile (multi-file feature, added round 9 review M7 -- both cheap with the existing stub, no new stub capability needed). NOT covered, as a recorded decision rather than an unremarked gap: repository discovery, frontend UI bug, backend API bug, refactor, ambiguous task. This harness's stub is a scripted tool-call sequence against a throwaway git fixture with no real UI/API surface and no live model -- faking those five would mean scripting a model's disambiguation/discovery behavior we can't actually exercise, i.e. padding, not coverage. A real attempt at those needs either richer fixtures (a real frontend/API surface to point verify commands at) or a live-model eval mode; both are follow-up epics, not this round's scope.",
  "tasks": [
    {
      "id": "create-hello-module",
      "category": "create",
      "objective": "Create hello.py with a greet(name) function that returns a friendly greeting string.",
      "scopePackage": "files",
      "scopePaths": [
        "hello.py"
      ],
      "maxRepairs": 1,
      "maxChangedFiles": 3,
      "fixtureFiles": {
        "README.md": "# fixture repo\n"
      },
      "verify": [
        "python3 -B -c \"import sys, hello; sys.exit(0 if 'Ada' in hello.greet('Ada') else 1)\""
      ],
      "stub": {
        "invocations": [
          [
            {
              "tool": "write_file",
              "arguments": {
                "path": "hello.py",
                "content": "def greet(name):\n    return f\"Hello, {name}!\"\n"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff --check"
              }
            },
            {
              "finish": "Created hello.py with a greet function."
            }
          ]
        ]
      },
      "expected": {
        "filesExist": [
          "hello.py"
        ],
        "fileContains": {
          "hello.py": [
            "def greet"
          ]
        }
      },
      "expectedOutcome": {
        "taskSuccess": true,
        "falseVerified": false,
        "budgetAdherence": true
      }
    },

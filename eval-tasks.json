      "id": "repair-fix-off-by-one",
      "category": "repair",
      "objective": "Fix count_positive in counter.py so it counts positive numbers correctly (off-by-one bug).",
      "scopePackage": "files",
      "scopePaths": [
        "counter.py"
      ],
      "maxRepairs": 2,
      "maxChangedFiles": 3,
      "fixtureFiles": {
        "counter.py": "def count_positive(xs):\n    n = 0\n    for x in xs:\n        if x > 1:\n            n += 1\n    return n\n"
      },
      "verify": [
        "python3 -B -c \"import counter, sys; sys.exit(0 if counter.count_positive([1, 2, 3]) == 3 else 1)\""
      ],
      "stub": {
        "invocations": [
          [
            {
              "tool": "edit_file",
              "arguments": {
                "path": "counter.py",
                "old_string": "if x > 1:",
                "new_string": "if x > 2:"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff --check"
              }
            },
            {
              "finish": "Loosened the threshold."
            }
          ],
          [
            {
              "tool": "edit_file",
              "arguments": {
                "path": "counter.py",
                "old_string": "if x > 2:",
                "new_string": "if x > 0:"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff"
              }
            },
            {
              "tool": "exec_shell_command",
              "arguments": {
                "command": "git diff --check"
              }
            },
            {
              "finish": "Fixed the off-by-one: positive means > 0."
            }
          ]
        ]
      },
      "expected": {
        "fileContains": {
          "counter.py": [
            "if x > 0:"
          ]
        }
      },
      "expectedOutcome": {
        "taskSuccess": true,
        "falseVerified": false,
        "budgetAdherence": true
      }
    },
